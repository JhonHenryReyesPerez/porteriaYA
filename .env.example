# PorteriaYa v2 — plantilla de variables de entorno.
# Copia este archivo a .env y pon valores reales. .env NO se versiona (§16).
#   cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_DB=porteriaya
POSTGRES_USER=porteriaya
POSTGRES_PASSWORD=cambiame
POSTGRES_PORT=5432

# La app corre fuera de Compose, asi que alcanza la BD en localhost (§3)
DB_URL=jdbc:postgresql://localhost:5432/porteriaya

# ---------- Seguridad ----------
# PIN de administrador (§7). Viaja en X-Admin-Pin. No lo dejes en 1234 para la entrega.
ADMIN_PIN=cambiame

# Secreto compartido con n8n (§10). DISTINTO del PIN: este nunca llega al navegador.
PORTERIA_SECRET=cambiame

# ---------- n8n ----------
# URL con la que n8n (dentro de Docker) alcanza la app (§3)
PORTERIA_BASE_URL=http://host.docker.internal:8080
N8N_WEBHOOK_URL=http://localhost:5678/webhook/porteriaya
N8N_PORT=5678

# Destinatario de las alertas y del resumen semanal (flujos 03, 04 y 07)
CORREO_ADMINISTRACION=administracion@example.test

# URL con la que el RESIDENTE abre la app desde su navegador. Distinta de
# PORTERIA_BASE_URL: esa es la que usa n8n desde dentro de Docker.
PORTERIA_URL_PUBLICA=http://localhost:8080

# ---------- Telegram (opcional) ----------
# Los nodos de Telegram llegan DESACTIVADOS y necesitan una credencial
# telegramApi creada a mano en n8n. Sin eso, todo sale por correo a Mailpit.
TELEGRAM_CHAT_ID=
# Rol con el que el bot consulta al asistente. RESIDENTE es el mas restrictivo:
# subirlo deja que el chat recupere los protocolos de vigilancia (§11).
TELEGRAM_ROL=RESIDENTE

# ---------- RAG ----------
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
RAG_EMBEDDING_MODELO=nomic-embed-text

# Proveedor del LLM: ollama | claude (§2, detras de LlmClient)
RAG_LLM_PROVEEDOR=ollama
# Con proveedor=ollama un modelo local (llama3.2); con proveedor=claude, claude-sonnet-5
RAG_LLM_MODELO=llama3.2
# Solo si RAG_LLM_PROVEEDOR=claude
ANTHROPIC_API_KEY=

# Limite de subida de documentos en MB (§16). Lo usan rag.subida y el multipart de Spring.
RAG_MAX_SUBIDA_MB=10

# ---------- Mailpit (SMTP de pruebas) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
